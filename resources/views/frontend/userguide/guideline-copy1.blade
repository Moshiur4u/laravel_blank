                                <!-- Card Definitions & Calculation Sources Table -->
                                <div class="overflow-x-auto border rounded-2xl border-slate-200/90 dark:border-slate-800">
                                    <table class="w-full text-left border-collapse">
                                        <thead>
                                            <tr
                                                class="text-xs font-bold tracking-wider uppercase border-b bg-stonecard dark:bg-slate-900/80 text-slate-600 dark:text-slate-400 border-slate-200 dark:border-slate-800">
                                                <th class="w-1/5 px-4 py-3">Card</th>
                                                <th class="w-1/3 px-4 py-3">কী বোঝায়</th>
                                                <th class="px-4 py-3">হিসাবের মূল উৎস</th>
                                            </tr>
                                        </thead>
                                        <tbody
                                            class="text-xs divide-y divide-slate-200/70 dark:divide-slate-800 sm:text-sm">
                                            <tr class="hover:bg-slate-50/70 dark:hover:bg-slate-800/30">
                                                <td class="py-3.5 px-4 font-bold text-slate-900 dark:text-white">Total
                                                    Purchase</td>
                                                <td class="py-3.5 px-4 text-slate-700 dark:text-slate-300">নির্বাচিত
                                                    সময়সীমায় supplier ledger-এ নথিভুক্ত মোট purchase</td>
                                                <td class="py-3.5 px-4 text-slate-600 dark:text-slate-400"><code
                                                        class="text-xs bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded">supplierledgers</code>-এর
                                                    total; রেকর্ড তৈরির তারিখ (<code
                                                        class="text-xs bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded">created_at</code>)
                                                    অনুযায়ী</td>
                                            </tr>
                                            <tr class="hover:bg-slate-50/70 dark:hover:bg-slate-800/30">
                                                <td class="py-3.5 px-4 font-bold text-slate-900 dark:text-white">Total
                                                    Revenue</td>
                                                <td class="py-3.5 px-4 text-slate-700 dark:text-slate-300">নির্বাচিত
                                                    সময়সীমার বিক্রি ও গণ্য business income</td>
                                                <td class="py-3.5 px-4 text-slate-600 dark:text-slate-400">Sales invoice-এর
                                                    subtotal থেকে discount বাদ দিয়ে VAT ও AIT যোগ; invoice-এর সঙ্গে যুক্ত
                                                    নয় এমন customer-ledger sale এবং customer payment নয় এমন credit
                                                    voucher-ও যুক্ত হয়। আগের বকেয়া নতুন revenue হিসেবে পুনরায় যোগ হয় না।
                                                </td>
                                            </tr>
                                            <tr class="hover:bg-slate-50/70 dark:hover:bg-slate-800/30">
                                                <td class="py-3.5 px-4 font-bold text-slate-900 dark:text-white">Total Due
                                                </td>
                                                <td class="py-3.5 px-4 text-slate-700 dark:text-slate-300">সময়সীমার
                                                    বিক্রি/লেনদেনে তৈরি বকেয়া</td>
                                                <td class="py-3.5 px-4 text-slate-600 dark:text-slate-400"><code
                                                        class="text-xs bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded">sale_invoices</code>-এর
                                                    due এবং invoice-এর সঙ্গে যুক্ত নয় এমন <code
                                                        class="text-xs bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded">customer_ledgers</code>-এর
                                                    sale due; invoice date বা sale date অনুযায়ী</td>
                                            </tr>
                                            <tr class="hover:bg-slate-50/70 dark:hover:bg-slate-800/30">
                                                <td class="py-3.5 px-4 font-bold text-slate-900 dark:text-white">Total
                                                    Expense</td>
                                                <td class="py-3.5 px-4 text-slate-700 dark:text-slate-300">সময়সীমার
                                                    employee payment ও debit voucher-এর মোট</td>
                                                <td class="py-3.5 px-4 text-slate-600 dark:text-slate-400"><code
                                                        class="text-xs bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded">employee_payment_vouchers.amount</code>
                                                    (payment date) এবং <code
                                                        class="text-xs bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded">voucher_entries.amount</code>-এর
                                                    debit রেকর্ড (voucher date)</td>
                                            </tr>
                                            <tr
                                                class="hover:bg-slate-50/70 dark:hover:bg-slate-800/30 bg-emerald-50/30 dark:bg-emerald-950/10">
                                                <td class="py-3.5 px-4 font-bold text-emerald-800 dark:text-emerald-300">
                                                    Net Profit</td>
                                                <td class="py-3.5 px-4 text-slate-700 dark:text-slate-300">revenue থেকে
                                                    purchase ও ব্যয়-সংক্রান্ত খরচ বাদ দেওয়ার পরের dashboard হিসাব</td>
                                                <td class="py-3.5 px-4 text-slate-600 dark:text-slate-400">Revenue থেকে
                                                    supplier ledger purchase, employee payment এবং supplier payment হিসেবে
                                                    গণনা না হওয়া debit voucher বাদ দিয়ে হিসাব করা হয়। এটি dashboard-এর
                                                    business summary; হিসাবের source record ও সময়সীমার ওপর নির্ভরশীল।</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>

                                <!-- Time Calculation & Profit Trend Grid -->
                                <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                                    <div
                                        class="p-4 space-y-2 border rounded-2xl bg-alabaster dark:bg-obsidian border-slate-200/80 dark:border-slate-800">
                                        <h3
                                            class="flex items-center gap-2 text-sm font-bold text-slate-900 dark:text-white">
                                            <i data-lucide="clock" class="w-4 h-4 text-accent-600"></i>
                                            সময় গণনা
                                        </h3>
                                        <p class="text-xs leading-relaxed sm:text-sm text-slate-600 dark:text-slate-300">
                                            <strong>Daily</strong> হলো আজকের দিন; <strong>Weekly</strong> হলো সোমবার থেকে
                                            পরের সোমবারের আগ পর্যন্ত চলতি সপ্তাহ; <strong>মাসিক card-এর অঙ্ক</strong> হলো
                                            চলতি calendar month। Dashboard-এর হিসাব server/application-এর তারিখ ব্যবহার করে।
                                        </p>
                                    </div>

                                    <div
                                        class="p-4 space-y-2 border rounded-2xl bg-alabaster dark:bg-obsidian border-slate-200/80 dark:border-slate-800">
                                        <h3
                                            class="flex items-center gap-2 text-sm font-bold text-slate-900 dark:text-white">
                                            <i data-lucide="bar-chart-2" class="w-4 h-4 text-indigoAccent-600"></i>
                                            Profit Trend ও অন্যান্য তথ্য
                                        </h3>
                                        <ul
                                            class="pl-4 space-y-1 text-xs list-disc sm:text-sm text-slate-600 dark:text-slate-300">
                                            <li>Profit Trend chart-এ <strong>Revenue column</strong> এবং <strong>Profit
                                                    line</strong> হিসেবে দেখায়।</li>
                                            <li>Chart-এর selector দিয়ে <strong>Daily, Weekly, Monthly</strong> বা
                                                <strong>Yearly</strong> সময়সীমা বেছে নেওয়া যায়। Daily-তে আজ, Weekly ও
                                                Monthly-তে সংশ্লিষ্ট দিনগুলো, আর Yearly-তে মাসভিত্তিক মান দেখা যায়।</li>
                                            <li>নিচের <strong>Top Selling Products</strong> এবং <strong>Top Sales
                                                    Employees</strong> অংশে সর্বোচ্চ বিক্রির পণ্য ও কর্মীদের তালিকা থাকে।
                                            </li>
                                        </ul>
                                    </div>
                                </div>

                                <!-- Dashboard Note -->
                                <div
                                    class="p-3.5 rounded-2xl bg-amber-50/80 dark:bg-amber-950/30 border border-amber-200/80 dark:border-amber-800/40 flex items-start gap-2.5 text-xs sm:text-sm text-amber-900 dark:text-amber-200">
                                    <i data-lucide="lightbulb"
                                        class="w-4 h-4 text-amber-600 dark:text-amber-400 shrink-0 mt-0.5"></i>
                                    <p>
                                        <strong>নোট:</strong> Dashboard-এর card-গুলোর অঙ্ক গোল করে দেখানো হতে পারে। Card-এর
                                        সময়সীমা ও chart-এর selector এক জিনিস নয়—chart-এর selector বদলালে card-এর
                                        Daily/Weekly/Monthly মান বদলায় না।
                                    </p>
                                </div>
                            </div>
                        </section>

                        <!-- ========================================================= -->
                        <!-- CHAPTER 4: SALES MENU: SALE -> CREATE SALE (Stepper Flow) -->
                        <!-- ========================================================= -->
                        <section id="section-sales"
                            class="overflow-hidden bg-white border shadow-xs searchable-section scroll-mt-24 dark:bg-charcoal rounded-3xl border-slate-200/90 dark:border-slate-800">
                            <!-- Section Header -->
                            <div
                                class="flex items-center justify-between px-6 py-5 border-b sm:px-8 border-slate-100 dark:border-slate-800/80 bg-stonecard/50 dark:bg-slate-900/40">
                                <div class="flex items-center gap-3.5">
                                    <span
                                        class="flex items-center justify-center text-base font-bold text-white w-9 h-9 rounded-xl bg-slate-900 dark:bg-accent-600 shadow-2xs">৪</span>
                                    <div>
                                        <h2
                                            class="text-lg font-bold tracking-tight sm:text-xl text-slate-900 dark:text-white">
                                            Sales Menu: Sale → Create Sale</h2>
                                        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400">বিক্রি তৈরির ৫টি
                                            ধারাবাহিক ধাপ, পেমেন্ট অপশন ও ইনভয়েস অ্যাকশন</p>
                                    </div>
                                </div>
                                <span
                                    class="hidden sm:inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-indigoAccent-50 dark:bg-indigo-950/60 text-indigoAccent-600 dark:text-indigo-400 text-xs font-mono font-medium border border-indigo-200/70 dark:border-indigo-800/50">
                                    Sales → Create Sale
                                </span>
                            </div>

                            <div class="p-6 space-y-6 sm:p-8">
                                <!-- Connected Vertical Stepper -->
                                <div
                                    class="relative space-y-6 before:absolute before:inset-0 before:ml-4 sm:before:ml-5 before:-translate-x-px before:h-full before:w-0.5 before:bg-slate-200 dark:before:bg-slate-800">

                                    <!-- ধাপ ১ -->
                                    <div class="relative flex items-start gap-4 sm:gap-5">
                                        <div
                                            class="z-10 flex items-center justify-center w-8 h-8 text-xs font-bold text-white sm:w-10 sm:h-10 rounded-xl bg-slate-900 dark:bg-accent-600 sm:text-sm shrink-0 shadow-2xs">
                                            ধাপ ১
                                        </div>
                                        <div
                                            class="flex-1 p-4 space-y-2 border sm:p-5 rounded-2xl bg-alabaster dark:bg-obsidian border-slate-200/80 dark:border-slate-800">
                                            <h3 class="text-base font-bold text-slate-900 dark:text-white">Create Sale খোলা
                                            </h3>
                                            <ol
                                                class="pl-5 space-y-1 text-xs list-decimal sm:text-sm text-slate-700 dark:text-slate-300">
                                                <li>Menu-তে <strong>Sales</strong> খুলুন।</li>
                                                <li><strong>Create Sale</strong> নির্বাচন করুন।</li>
                                            </ol>
                                            <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400">
                                                Customer, Sale Items এবং Invoice & Payment অংশ পূরণ করুন। প্রয়োজনীয়
                                                permission না থাকলে এই menu বা form দেখা যাবে না।
                                            </p>
                                        </div>
                                    </div>

                                    <!-- ধাপ ২ -->
                                    <div class="relative flex items-start gap-4 sm:gap-5">
                                        <div
                                            class="z-10 flex items-center justify-center w-8 h-8 text-xs font-bold text-white sm:w-10 sm:h-10 rounded-xl bg-slate-900 dark:bg-accent-600 sm:text-sm shrink-0 shadow-2xs">
                                            ধাপ ২
                                        </div>
                                        <div
                                            class="flex-1 p-4 sm:p-5 rounded-2xl bg-alabaster dark:bg-obsidian border border-slate-200/80 dark:border-slate-800 space-y-2.5">
                                            <h3 class="text-base font-bold text-slate-900 dark:text-white">Customer খোঁজা
                                            </h3>
                                            <ol
                                                class="list-decimal pl-5 space-y-1.5 text-xs sm:text-sm text-slate-700 dark:text-slate-300">
                                                <li><strong>Customer Name or Phone</strong> ঘরে গ্রাহকের নাম বা ফোন নম্বর
                                                    লিখুন।</li>
                                                <li>নাম লিখলে মিলে যাওয়া customer suggestion দেখুন এবং সঠিক গ্রাহকের
                                                    suggestion নির্বাচন করুন। ফোন নম্বর লিখলে বা <strong>Find</strong> চাপলে
                                                    customer lookup হয়।</li>
                                                <li>আগে থেকে থাকা customer পাওয়া গেলে তার নাম ও ledger load হবে।
                                                    <strong>Outstanding</strong>-এ বর্তমান বকেয়া এবং ledger-এ সংশ্লিষ্ট
                                                    লেনদেন দেখা যায়।</li>
                                                <li><strong>Add outstanding due to this invoice</strong> checkbox-এ টিক দিলে
                                                    আগের বকেয়াটি এই invoice total-এ যোগ হবে। টিক না দিলে আগের বকেয়া নতুন
                                                    invoice total-এ যোগ হবে না।</li>
                                                <li>Customer না পাওয়া গেলে saved customer balance দেখানো হবে না।
                                                    Checkout-এর সময় নতুন customer save করা অথবা walk-in হিসেবে বিক্রি করার
                                                    বিকল্প আসবে।</li>
                                            </ol>
                                            <div
                                                class="p-3 text-xs border rounded-xl bg-amber-50/90 dark:bg-amber-950/30 border-amber-200/80 dark:border-amber-800/40 text-amber-900 dark:text-amber-200">
                                                <strong>গুরুত্বপূর্ণ:</strong> Customer বাছাই হয় name/phone search ও
                                                suggestion দিয়ে। Checkbox-টি customer select করার জন্য নয়; এটি আগের বকেয়া
                                                invoice-এ যোগ করার জন্য।
                                            </div>
                                        </div>
                                    </div>

                                    <!-- ধাপ ৩ -->
                                    <div class="relative flex items-start gap-4 sm:gap-5">
                                        <div
                                            class="z-10 flex items-center justify-center w-8 h-8 text-xs font-bold text-white sm:w-10 sm:h-10 rounded-xl bg-slate-900 dark:bg-accent-600 sm:text-sm shrink-0 shadow-2xs">
                                            ধাপ ৩
                                        </div>
                                        <div
                                            class="flex-1 p-4 sm:p-5 rounded-2xl bg-alabaster dark:bg-obsidian border border-slate-200/80 dark:border-slate-800 space-y-2.5">
                                            <h3 class="text-base font-bold text-slate-900 dark:text-white">Sale Items যোগ
                                                করা</h3>
                                            <ol
                                                class="list-decimal pl-5 space-y-1.5 text-xs sm:text-sm text-slate-700 dark:text-slate-300">
                                                <li><strong>Product</strong> ঘরে পণ্যের নাম বা code লিখুন।</li>
                                                <li>Inventory-তে থাকা এবং বিক্রির জন্য stock থাকা পণ্য suggestion-এ আসবে;
                                                    সঠিক পণ্যটি নির্বাচন করুন।</li>
                                                <li>পণ্য নির্বাচন হলে inventory-র selling price ও unit বসে এবং quantity
                                                    সাধারণত <strong>1</strong> দিয়ে শুরু হয়।</li>
                                                <li><strong>Quantity</strong> লিখুন। প্রতিটি লাইনের
                                                    <strong>LineTotal</strong> স্বয়ংক্রিয়ভাবে <code
                                                        class="px-1.5 py-0.5 rounded bg-slate-200/80 dark:bg-slate-800 text-xs font-semibold">UnitPrice
                                                        × Quantity</code> হিসেবে আপডেট হবে। <strong>Subtotal</strong>-ও
                                                    সঙ্গে সঙ্গে পুনর্গণনা হয়।</li>
                                                <li>আরও পণ্য যোগ করতে <strong>Add Product</strong> চাপুন। কোনো পণ্য সরাতে
                                                    তার সারির delete আইকন ব্যবহার করুন।</li>
                                            </ol>
                                            <p class="text-xs font-medium text-rose-600 dark:text-rose-400">
                                                ⚠ Stock-এর বেশি quantity দিলে সতর্কতা দেখাবে; প্রয়োজনমতো quantity কমান।
                                            </p>
                                        </div>
                                    </div>

                                    <!-- ধাপ ৪ -->
                                    <div class="relative flex items-start gap-4 sm:gap-5">
                                        <div
                                            class="z-10 flex items-center justify-center w-8 h-8 text-xs font-bold text-white sm:w-10 sm:h-10 rounded-xl bg-slate-900 dark:bg-accent-600 sm:text-sm shrink-0 shadow-2xs">
                                            ধাপ ৪
                                        </div>
                                        <div
                                            class="flex-1 p-4 space-y-3 border sm:p-5 rounded-2xl bg-alabaster dark:bg-obsidian border-slate-200/80 dark:border-slate-800">
                                            <h3 class="text-base font-bold text-slate-900 dark:text-white">Invoice &
                                                Payment</h3>
                                            <ol
                                                class="pl-5 space-y-2 text-xs list-decimal sm:text-sm text-slate-700 dark:text-slate-300">
                                                <li><strong>Discount Type</strong> থেকে <strong>Amount</strong> (নির্দিষ্ট
                                                    টাকা) অথবা <strong>Percent</strong> বেছে নিন; পাশের ঘরে discount লিখুন।
                                                </li>
                                                <li><strong>VAT (%)</strong> ও <strong>AIT (%)</strong>-এ শতাংশের হার দিন।
                                                    Discount বাদ দেওয়ার পরের অঙ্কের ওপর এগুলোর টাকা স্বয়ংক্রিয়ভাবে হিসাব
                                                    হয়।</li>
                                                <li><strong>Amount Received</strong>-এ এখন যে টাকা নিচ্ছেন তা লিখুন।
                                                    <strong>Invoice Total</strong> ও <strong>Balance Due</strong>
                                                    স্বয়ংক্রিয়ভাবে আপডেট হবে।</li>
                                                <li>
                                                    টাকা গ্রহণ করলে <strong>Payment Method</strong> নির্বাচন করুন:
                                                    <div class="flex flex-wrap gap-1.5 mt-1.5">
                                                        <span
                                                            class="px-2 py-0.5 rounded-md bg-white dark:bg-charcoal border border-slate-200 dark:border-slate-700 font-mono text-xs font-semibold">Cash</span>
                                                        <span
                                                            class="px-2 py-0.5 rounded-md bg-white dark:bg-charcoal border border-slate-200 dark:border-slate-700 font-mono text-xs font-semibold">Bank</span>
                                                        <span
                                                            class="px-2 py-0.5 rounded-md bg-white dark:bg-charcoal border border-slate-200 dark:border-slate-700 font-mono text-xs font-semibold">Nagad</span>
                                                        <span
                                                            class="px-2 py-0.5 rounded-md bg-white dark:bg-charcoal border border-slate-200 dark:border-slate-700 font-mono text-xs font-semibold">bKash</span>
                                                        <span
                                                            class="px-2 py-0.5 rounded-md bg-white dark:bg-charcoal border border-slate-200 dark:border-slate-700 font-mono text-xs font-semibold">Rocket</span>
                                                        <span
                                                            class="px-2 py-0.5 rounded-md bg-white dark:bg-charcoal border border-slate-200 dark:border-slate-700 font-mono text-xs font-semibold">Upay</span>
                                                    </div>
                                                </li>
                                                <li>
                                                    <strong>Checkout</strong> চাপলে নতুন customer-এর ক্ষেত্রে একটি
                                                    confirmation আসবে:
                                                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 mt-2">
                                                        <div
                                                            class="p-2.5 rounded-xl bg-emerald-50/70 dark:bg-emerald-950/30 border border-emerald-200/70 dark:border-emerald-800/40 text-xs">
                                                            <div class="font-bold text-emerald-800 dark:text-emerald-300">
                                                                Yes, save customer</div>
                                                            <p class="text-slate-600 dark:text-slate-400 mt-0.5">গ্রাহকের
                                                                নাম লিখুন; Email ও Address ঐচ্ছিক। এরপর checkout সম্পন্ন
                                                                হবে।</p>
                                                        </div>
                                                        <div
                                                            class="p-2.5 rounded-xl bg-blue-50/70 dark:bg-blue-950/30 border border-blue-200/70 dark:border-blue-800/40 text-xs">
                                                            <div class="font-bold text-blue-800 dark:text-blue-300">No,
                                                                walk-in</div>
                                                            <p class="text-slate-600 dark:text-slate-400 mt-0.5">customer
                                                                record সংরক্ষণ হবে না। Amount Received-এ invoice-এর পুরো মোট
                                                                টাকা বসবে; Payment Method নির্বাচন করে checkout করুন।
                                                                Walk-in sale-এ পুরো invoice amount পরিশোধ করতে হয়।</p>
                                                        </div>
                                                        <div
                                                            class="p-2.5 rounded-xl bg-rose-50/70 dark:bg-rose-950/30 border border-rose-200/70 dark:border-rose-800/40 text-xs">
                                                            <div class="font-bold text-rose-800 dark:text-rose-300">Cancel
                                                                sale</div>
                                                            <p class="text-slate-600 dark:text-slate-400 mt-0.5">checkout
                                                                বাতিল হবে।</p>
                                                        </div>
                                                    </div>
                                                </li>
                                                <li><strong>Checkout & Print Invoice</strong> চাপুন। Sale সংরক্ষণের পর
                                                    invoice page খুলবে এবং print dialog চালু হতে পারে। Sale-এর পরে stock কমে
                                                    যায়।</li>
                                            </ol>
                                            <div
                                                class="p-3 text-xs bg-white border rounded-xl dark:bg-charcoal border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300">
                                                Invoice-এর মোট অঙ্কে Subtotal, discount, VAT, AIT এবং checkbox দিয়ে যোগ করা
                                                হলে Previous Due থাকে। <strong>Balance Due</strong> হলো Invoice Total থেকে
                                                Amount Received বাদ দেওয়ার পরের বাকি টাকা।
                                            </div>
                                        </div>
                                    </div>

                                    <!-- ধাপ ৫ -->
                                    <div class="relative flex items-start gap-4 sm:gap-5">
                                        <div
                                            class="z-10 flex items-center justify-center w-8 h-8 text-xs font-bold text-white sm:w-10 sm:h-10 rounded-xl bg-slate-900 dark:bg-accent-600 sm:text-sm shrink-0 shadow-2xs">
                                            ধাপ ৫
                                        </div>
                                        <div
                                            class="flex-1 p-4 sm:p-5 rounded-2xl bg-alabaster dark:bg-obsidian border border-slate-200/80 dark:border-slate-800 space-y-2.5">
                                            <h3 class="text-base font-bold text-slate-900 dark:text-white">Invoice দেখা,
                                                update ও print</h3>
                                            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300">
                                                Invoice page-এ permission অনুযায়ী নিচের action-গুলো থাকতে পারে:
                                            </p>
                                            <ul class="space-y-2 text-xs sm:text-sm text-slate-700 dark:text-slate-300">
                                                <li class="flex items-start gap-2">
                                                    <span
                                                        class="px-2 py-0.5 rounded bg-emerald-100 dark:bg-emerald-950 text-emerald-800 dark:text-emerald-300 font-mono font-semibold text-xs shrink-0">New
                                                        Sale</span>
                                                    <span>Create Sale page-এ ফেরে।</span>
                                                </li>
                                                <li class="flex items-start gap-2">
                                                    <span
                                                        class="px-2 py-0.5 rounded bg-blue-100 dark:bg-blue-950 text-blue-800 dark:text-blue-300 font-mono font-semibold text-xs shrink-0">Update
                                                        Invoice</span>
                                                    <span>Invoice edit form খোলে; items, quantity, unit price, discount,
                                                        VAT/AIT, payment received, notes বা terms সংশোধন করে Update Invoice
                                                        চাপুন। সংরক্ষণের পর stock, customer ledger, voucher ও
                                                        dashboard-সংশ্লিষ্ট totals সমন্বয় হয়। গ্রাহকের পরিচয় update
                                                        form-এ অপরিবর্তিত থাকে।</span>
                                                </li>
                                                <li class="flex items-start gap-2">
                                                    <span
                                                        class="px-2 py-0.5 rounded bg-rose-100 dark:bg-rose-950 text-rose-800 dark:text-rose-300 font-mono font-semibold text-xs shrink-0">Void
                                                        Invoice</span>
                                                    <span>confirmation-এর পর invoice বাতিল করে সংশ্লিষ্ট stock, ledger,
                                                        payment/voucher ও due entries reverse করে। এটি সাধারণ edit নয়;
                                                        প্রয়োজন নিশ্চিত হয়ে তবেই ব্যবহার করুন।</span>
                                                </li>
                                                <li class="flex items-start gap-2">
                                                    <span
                                                        class="px-2 py-0.5 rounded bg-indigo-100 dark:bg-indigo-950 text-indigo-800 dark:text-indigo-300 font-mono font-semibold text-xs shrink-0">Print
                                                        logo watermark</span>
                                                    <span>সংস্থার logo থাকলে এবং অনুমতি থাকলে printout-এ logo watermark
                                                        চালু/বন্ধ করে।</span>
                                                </li>
                                                <li class="flex items-start gap-2">
                                                    <span
                                                        class="px-2 py-0.5 rounded bg-slate-200 dark:bg-slate-800 text-slate-800 dark:text-slate-200 font-mono font-semibold text-xs shrink-0">Print
                                                        Invoice</span>
                                                    <span>invoice print dialog খোলে। Watermark চাইলে আগে Print logo
                                                        watermark নির্বাচন করুন।</span>
                                                </li>
                                            </ul>
                                            <p class="pt-1 text-xs text-slate-500 dark:text-slate-400">
                                                Update Invoice এবং Void Invoice role/permission এবং invoice-এর তারিখ
                                                অনুযায়ী দেখা যায়। কোনো button না থাকলে administrator-এর সঙ্গে যোগাযোগ
                                                করুন।
                                            </p>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </section>

                        <!-- ========================================================= -->
                        <!-- CHAPTER 5: RECENT INVOICES (Live Preview Table + Guide)   -->
                        <!-- ========================================================= -->
                        <section id="section-invoices"
                            class="overflow-hidden bg-white border shadow-xs searchable-section scroll-mt-24 dark:bg-charcoal rounded-3xl border-slate-200/90 dark:border-slate-800">
                            <!-- Section Header -->
                            <div
                                class="flex items-center justify-between px-6 py-5 border-b sm:px-8 border-slate-100 dark:border-slate-800/80 bg-stonecard/50 dark:bg-slate-900/40">
                                <div class="flex items-center gap-3.5">
                                    <span
                                        class="flex items-center justify-center text-base font-bold text-white w-9 h-9 rounded-xl bg-slate-900 dark:bg-accent-600 shadow-2xs">৫</span>
                                    <div>
                                        <h2
                                            class="text-lg font-bold tracking-tight sm:text-xl text-slate-900 dark:text-white">
                                            Recent Invoices</h2>
                                        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400">সর্বশেষ ১০টি
                                            ইনভয়েসের টেবিল কলাম ও অ্যাকশন বাটন পরিচিতি</p>
                                    </div>
                                </div>
                            </div>

                            <div class="p-6 space-y-6 sm:p-8">
                                <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300">
                                    Recent Invoices টেবিলে সর্বশেষ ১০টি invoice থাকে। প্রতিটি কলামের অর্থ:
                                </p>

                                <!-- Column Definitions Table -->
                                <div class="overflow-x-auto border rounded-2xl border-slate-200/90 dark:border-slate-800">
                                    <table class="w-full text-left border-collapse">
                                        <thead>
                                            <tr
                                                class="text-xs font-bold tracking-wider uppercase border-b bg-stonecard dark:bg-slate-900/80 text-slate-600 dark:text-slate-400 border-slate-200 dark:border-slate-800">
                                                <th class="w-1/3 px-4 py-3">কলাম</th>
                                                <th class="px-4 py-3">অর্থ</th>
                                            </tr>
                                        </thead>
                                        <tbody
                                            class="text-xs divide-y divide-slate-200/70 dark:divide-slate-800 sm:text-sm">
                                            <tr class="hover:bg-slate-50/70 dark:hover:bg-slate-800/30">
                                                <td class="px-4 py-3 font-mono font-bold text-slate-900 dark:text-white">
                                                    Invoice</td>
                                                <td class="px-4 py-3 text-slate-700 dark:text-slate-300">Invoice নম্বর</td>
                                            </tr>
                                            <tr class="hover:bg-slate-50/70 dark:hover:bg-slate-800/30">
                                                <td class="px-4 py-3 font-mono font-bold text-slate-900 dark:text-white">
                                                    Date</td>
                                                <td class="px-4 py-3 text-slate-700 dark:text-slate-300">Invoice তৈরির
                                                    তারিখ</td>
                                            </tr>
                                            <tr class="hover:bg-slate-50/70 dark:hover:bg-slate-800/30">
                                                <td class="px-4 py-3 font-mono font-bold text-slate-900 dark:text-white">
                                                    Customer Phone</td>
                                                <td class="px-4 py-3 text-slate-700 dark:text-slate-300">Invoice-এ সংরক্ষিত
                                                    customer phone</td>
                                            </tr>
                                            <tr class="hover:bg-slate-50/70 dark:hover:bg-slate-800/30">
                                                <td class="px-4 py-3 font-mono font-bold text-slate-900 dark:text-white">
                                                    Employee</td>
                                                <td class="px-4 py-3 text-slate-700 dark:text-slate-300">Sale তৈরি করা
                                                    employee; পাওয়া না গেলে <code
                                                        class="text-xs bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded font-semibold">N/A</code>
                                                </td>
                                            </tr>
                                            <tr class="hover:bg-slate-50/70 dark:hover:bg-slate-800/30">
                                                <td class="px-4 py-3 font-mono font-bold text-slate-900 dark:text-white">
                                                    Total</td>
                                                <td class="px-4 py-3 text-slate-700 dark:text-slate-300">Invoice-এর মোট
                                                    টাকা</td>
                                            </tr>
                                            <tr class="hover:bg-slate-50/70 dark:hover:bg-slate-800/30">
                                                <td class="px-4 py-3 font-mono font-bold text-slate-900 dark:text-white">
                                                    Due</td>
                                                <td class="px-4 py-3 text-slate-700 dark:text-slate-300">Invoice-এর বকেয়া
                                                    টাকা</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>

                                <!-- Row Action Buttons & Notes -->
                                <div class="space-y-3">
                                    <h3 class="text-sm font-bold text-slate-900 dark:text-white">প্রতিটি row-এর action
                                        button:</h3>
                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5">
                                        <div
                                            class="flex items-start gap-3 p-4 border rounded-2xl bg-alabaster dark:bg-obsidian border-slate-200/80 dark:border-slate-800">
                                            <span
                                                class="p-2 rounded-xl bg-indigoAccent-50 dark:bg-indigo-950 text-indigoAccent-600 dark:text-indigo-400 shrink-0">
                                                <i data-lucide="eye" class="w-4 h-4"></i>
                                            </span>
                                            <div>
                                                <h4 class="text-xs font-bold text-slate-900 dark:text-white sm:text-sm">
                                                    View Invoice (চোখের আইকন)</h4>
                                                <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 mt-0.5">
                                                    সম্পূর্ণ invoice ও তার print/update/void action-গুলো খোলে।</p>
                                            </div>
                                        </div>
                                        <div
                                            class="flex items-start gap-3 p-4 border rounded-2xl bg-alabaster dark:bg-obsidian border-slate-200/80 dark:border-slate-800">
                                            <span
                                                class="p-2 rounded-xl bg-emerald-50 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-400 shrink-0">
                                                <i data-lucide="truck" class="w-4 h-4"></i>
                                            </span>
                                            <div>
                                                <h4 class="text-xs font-bold text-slate-900 dark:text-white sm:text-sm">
                                                    Delivery Challan</h4>
                                                <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 mt-0.5">ওই
                                                    sale-এর পণ্য ও delivery-সংক্রান্ত challan খোলে।</p>
                                            </div>
                                        </div>
                                    </div>

                                    <div
                                        class="p-4 rounded-2xl bg-stonecard dark:bg-obsidian border border-slate-200/80 dark:border-slate-800 text-xs sm:text-sm text-slate-600 dark:text-slate-300 space-y-1.5">
                                        <p>
                                            Update/Void button Recent Invoices row-তে নেই; সেগুলো invoice খুললে permission
                                            অনুযায়ী দেখা যায়।
                                        </p>
                                        <p>
                                            নতুন invoice না থাকলে <code
                                                class="px-2 py-0.5 rounded bg-white dark:bg-charcoal border border-slate-200 dark:border-slate-700 font-mono text-xs text-slate-800 dark:text-slate-200">No
                                                invoices have been created yet.</code> বার্তাটি দেখানো হয়।
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </section>

                    </main>

                    <!-- Interactive Script -->
                    <script>
                        document.addEventListener('DOMContentLoaded', () => {
                            if (window.lucide) {
                                lucide.createIcons();
                            }

                            // 1. Dark Mode Toggle
                            const themeToggle = document.getElementById('theme-toggle');
                            const htmlEl = document.documentElement;

                            if (localStorage.getItem('manual-theme') === 'dark' ||
                                (!localStorage.getItem('manual-theme') && window.matchMedia('(prefers-color-scheme: dark)').matches)
                                ) {
                                htmlEl.classList.add('dark');
                            }

                            themeToggle.addEventListener('click', () => {
                                htmlEl.classList.toggle('dark');
                                localStorage.setItem('manual-theme', htmlEl.classList.contains('dark') ? 'dark' : 'light');
                            });

                            // 2. Demo Eye Toggle in Login Preview Card
                            const demoEyeBtn = document.getElementById('demo-eye-btn');
                            if (demoEyeBtn) {
                                let shown = false;
                                demoEyeBtn.addEventListener('click', () => {
                                    shown = !shown;
                                    const span = demoEyeBtn.previousElementSibling.querySelector('span');
                                    span.textContent = shown ? 'MySecretPass123' : '••••••••••••';
                                });
                            }

                            // 3. Module Segmented Pill Filter
                            const moduleTabs = document.querySelectorAll('.module-tab');
                            const moduleGroups = document.querySelectorAll('.module-group');

                            moduleTabs.forEach(tab => {
                                tab.addEventListener('click', () => {
                                    const filter = tab.getAttribute('data-filter');

                                    moduleTabs.forEach(t => {
                                        t.classList.remove('bg-white', 'dark:bg-charcoal', 'text-slate-900',
                                            'dark:text-white', 'shadow-2xs', 'border',
                                            'border-slate-200/60', 'dark:border-slate-700',
                                            'font-semibold');
                                        t.classList.add('text-slate-600', 'dark:text-slate-400',
                                            'font-medium');
                                    });

                                    tab.classList.remove('text-slate-600', 'dark:text-slate-400', 'font-medium');
                                    tab.classList.add('bg-white', 'dark:bg-charcoal', 'text-slate-900',
                                        'dark:text-white', 'shadow-2xs', 'border', 'border-slate-200/60',
                                        'dark:border-slate-700', 'font-semibold');

                                    moduleGroups.forEach(group => {
                                        if (filter === 'all' || group.getAttribute('data-category') ===
                                            filter) {
                                            group.classList.remove('hidden');
                                        } else {
                                            group.classList.add('hidden');
                                        }
                                    });
                                });
                            });

                            // 4. Command Search ('/' shortcut) & Live Highlighting
                            const searchInput = document.getElementById('search-input');
                            const mobileSearchInput = document.getElementById('mobile-search-input');
                            const mobileSearchBtn = document.getElementById('mobile-search-btn');
                            const mobileSearchBar = document.getElementById('mobile-search-bar');
                            const clearSearchBtn = document.getElementById('clear-search');
                            const searchKbd = document.getElementById('search-kbd');
                            const searchStatus = document.getElementById('search-status');
                            const searchCount = document.getElementById('search-count');

                            if (mobileSearchBtn) {
                                mobileSearchBtn.addEventListener('click', () => {
                                    mobileSearchBar.classList.toggle('hidden');
                                    if (!mobileSearchBar.classList.contains('hidden')) {
                                        mobileSearchInput.focus();
                                    }
                                });
                            }

                            // Keyboard '/' shortcut to focus search
                            document.addEventListener('keydown', (e) => {
                                if (e.key === '/' && document.activeElement !== searchInput && document.activeElement !==
                                    mobileSearchInput) {
                                    e.preventDefault();
                                    searchInput.focus();
                                } else if (e.key === 'Escape' && (document.activeElement === searchInput || document
                                        .activeElement === mobileSearchInput)) {
                                    searchInput.value = '';
                                    mobileSearchInput.value = '';
                                    performSearch('');
                                    document.activeElement.blur();
                                }
                            });

                            const searchableBlocks = document.querySelectorAll(
                                '#manual-content p, #manual-content td, #manual-content li, #manual-content h2, #manual-content h3, #manual-content h4'
                                );
                            searchableBlocks.forEach(el => {
                                el.dataset.originalHtml = el.innerHTML;
                            });

                            function escapeRegExp(string) {
                                return string.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
                            }

                            function performSearch(rawQuery) {
                                const query = rawQuery.trim();

                                if (!query) {
                                    clearSearchBtn.classList.add('hidden');
                                    searchKbd.classList.remove('hidden');
                                    searchStatus.classList.add('hidden');
                                    searchableBlocks.forEach(el => {
                                        el.innerHTML = el.dataset.originalHtml;
                                    });
                                    return;
                                }

                                clearSearchBtn.classList.remove('hidden');
                                searchKbd.classList.add('hidden');
                                moduleGroups.forEach(g => g.classList.remove('hidden'));

                                const regex = new RegExp(`(${escapeRegExp(query)})`, 'gi');
                                let matchCount = 0;

                                searchableBlocks.forEach(el => {
                                    const original = el.dataset.originalHtml;
                                    const parts = original.split(/(<[^>]+>)/g);
                                    let hasMatch = false;

                                    const highlighted = parts.map(part => {
                                        if (part.startsWith('<')) return part;
                                        if (regex.test(part)) {
                                            hasMatch = true;
                                            return part.replace(regex, '<mark class="search-highlight">$1</mark>');
                                        }
                                        return part;
                                    }).join('');

                                    el.innerHTML = highlighted;
                                    if (hasMatch) matchCount++;
                                });

                                searchCount.textContent = matchCount;
                                searchStatus.classList.remove('hidden');
                            }

                            searchInput.addEventListener('input', (e) => {
                                mobileSearchInput.value = e.target.value;
                                performSearch(e.target.value);
                            });

                            mobileSearchInput.addEventListener('input', (e) => {
                                searchInput.value = e.target.value;
                                performSearch(e.target.value);
                            });

                            clearSearchBtn.addEventListener('click', () => {
                                searchInput.value = '';
                                mobileSearchInput.value = '';
                                performSearch('');
                                searchInput.focus();
                            });

                            // 5. Scroll-Spy for Top Horizontal Navigation Menu
                            const navItems = document.querySelectorAll('.toc-nav-item');
                            const sections = document.querySelectorAll('.searchable-section');

                            function setActiveNavItem(targetId) {
                                navItems.forEach(link => {
                                    if (link.getAttribute('data-target') === targetId) {
                                        link.classList.remove('bg-white/80', 'dark:bg-charcoal', 'text-slate-600',
                                            'dark:text-slate-300', 'border', 'border-slate-200/80',
                                            'dark:border-slate-800', 'font-medium');
                                        link.classList.add('bg-slate-900', 'text-white', 'dark:bg-accent-600',
                                            'dark:text-white', 'shadow-xs', 'font-semibold');
                                        link.scrollIntoView({
                                            behavior: 'smooth',
                                            block: 'nearest',
                                            inline: 'center'
                                        });
                                    } else {
                                        link.classList.remove('bg-slate-900', 'text-white', 'dark:bg-accent-600',
                                            'dark:text-white', 'shadow-xs', 'font-semibold');
                                        link.classList.add('bg-white/80', 'dark:bg-charcoal', 'text-slate-600',
                                            'dark:text-slate-300', 'border', 'border-slate-200/80',
                                            'dark:border-slate-800', 'font-medium');
                                    }
                                });
                            }

                            navItems.forEach(link => {
                                link.addEventListener('click', () => {
                                    setActiveNavItem(link.getAttribute('data-target'));
                                });
                            });

                            const sectionObserver = new IntersectionObserver((entries) => {
                                entries.forEach(entry => {
                                    if (entry.isIntersecting) {
                                        setActiveNavItem(entry.target.id);
                                    }
                                });
                            }, {
                                root: null,
                                rootMargin: '-100px 0px -65% 0px',
                                threshold: 0
                            });

                            sections.forEach(sec => sectionObserver.observe(sec));
                        });
                    </script>
                </body>

                </html>
            </div>
        </div>
    </div>
@endsection
