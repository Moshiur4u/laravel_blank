                                                <tr
                                                    class="transition-colors hover:bg-slate-50/80 dark:hover:bg-slate-800/30">
                                                    <td class="px-4 py-3 font-semibold text-rose-600 dark:text-rose-400">
                                                        Password ফাঁকা</td>
                                                    <td class="px-4 py-3 text-slate-700 dark:text-slate-300">Password লিখে
                                                        আবার চেষ্টা করুন।</td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>

